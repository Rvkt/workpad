filters:
  and:
    - file.ext == "md"
views:
  - type: table
    name: All Notes
    order:
      - file.name
      - file.folder
      - tags
      - file.mtime
  - type: table
    name: Daily Notes
    filters:
      and:
        - file.inFolder("01 Daily Notes")
    order:
      - file.name
      - file.folder
      - tags
      - file.mtime
  - type: table
    name: Work
    filters:
      and:
        - file.inFolder("02 Work")
    order:
      - file.name
      - file.folder
      - tags
      - file.mtime
  - type: table
    name: Journal
    filters:
      and:
        - file.inFolder("03 Journal")
    order:
      - file.name
      - tags
      - file.mtime
  - type: table
    name: Projects & Goals
    filters:
      and:
        - file.inFolder("04 Projects & Goals")
    order:
      - file.name
      - file.folder
      - status
      - file.mtime
  - type: table
    name: Knowledge
    filters:
      and:
        - file.inFolder("05 Knowledge")
    order:
      - file.name
      - file.folder
      - tags
      - file.mtime
  - type: table
    name: Study
    filters:
      and:
        - file.inFolder("05 Knowledge/Study")
    order:
      - file.name
      - file.folder
      - tags
      - file.mtime
  - type: table
    name: Resources
    filters:
      and:
        - file.inFolder("06 Resources")
    order:
      - file.name
      - file.folder
      - tags
      - file.mtime
  - type: table
    name: Archive
    filters:
      and:
        - file.inFolder("07 Archive")
    order:
      - file.name
      - file.folder
  - type: table
    name: System
    filters:
      and:
        - file.inFolder("99 System")
    order:
      - file.name
      - file.folder
